Formate der benutzten RANDOM-Dateien

TYPE ProjTyp
Bem1 AS STRING * 66: Bem2 AS STRING * 66 Erläuterungstext 1 (66 Zeichen)
Erläuterungstext 2 (66 Zeichen)
DB AS STRING * 1
Rest AS STRING * 3 Frei
Str AS STRING * 4 Strecken/Gleisnu,mmer
TSVSt AS DOUBLE Von Station
TSBSt AS DOUBLE Bis Station
TSAnz AS INTEGER Anzahl Elemente Kilometerlinie
TSFehl AS INTEGER Anzahl Fehlstationen
Scheren AS INTEGER Anzahl Gleisscheren
TDif AS DOUBLE Größte minus kleinste Tangentenrichtung
TRAnz AS INTEGER Anzahl Elemente rechte Trasse
TLAnz AS INTEGER Anzahl Elemente linke Trasse
RRAnz AS INTEGER Anzahl Elemente Überhöhung rechts
RLAnz AS INTEGER Anzahl Elemente Überhöhung links
GRAnz AS INTEGER Anzahl Elemente rechte Gradiente
GLAnz AS INTEGER Anzahl Elemente linke Gradiente
MaxY AS DOUBLE Größte Knickabweichung in Y
MaxX AS DOUBLE Größte Knickabweichung in X
MaxT AS DOUBLE Größte Knickabweichung der Tangentenrichtung
Datei2 AS STRING * 8 Name der Koordinatendatei
FDate AS STRING * 8 Datum der Projekteröffnung
Datum AS STRING * 8 Datum der letzten Änderung
Prg AS INTEGER Programmnummer der letzten Änderung
QR AS INTEGER Anzahl Querfelder rechts
QL AS INTEGER Anzahl Querfelder links
Art AS INTEGER Bahnhofsgleis=1 Strecke=2
END TYPE

TYPE Gleis
R1 AS DOUBLE Radius am Anfang
R2 AS DOUBLE Radius am Ende
Ya AS DOUBLE Y Anfang
Xa AS DOUBLE X Anfang
Ta AS DOUBLE Startrichtung
S AS DOUBLE Station
Kz AS INTEGER Kennzeichen Krümmung
L AS DOUBLE Länge des Elementes
T AS DOUBLE Verbesserte Startrichtung
Fakt AS DOUBLE Längenfaktor
P AS SINGLE Angfangspunktnummer
END TYPE

TYPE Gradiente
S AS DOUBLE Station
H AS DOUBLE Höhe
R AS DOUBLE Ausrundungsradius
T AS DOUBLE Tangentenlänge Ausrundung
Pkt AS LONG Punktnummer Neigungswechsel * 10000
PktAA AS LONG Punktnummer Ausrundunganfang * 10000
PktAE AS LONG Punktnummer Ausrundunganfang * 10000
END TYPE

TYPE Rampe
S AS DOUBLE Station
U AS DOUBLE Überhöhung in mm
P AS DOUBLE Punktnummer
Kz AS INTEGER Rampenkennzeichen
END TYPE

TYPE Bereich
P AS DOUBLE Punktnummer
Y AS DOUBLE Abstand für AXTRAN
X AS DOUBLE Genauigkeitsschranke für AXTRAN
END TYPE

TYPE Querfeld
R AS DOUBLE Punktnummer rechts
L AS DOUBLE Punktnummer links
St AS DOUBLE Station
END TYPE




