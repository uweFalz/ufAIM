@startuml

title ufAIM – Ultimate Architecture Map v3

skinparam packageStyle rectangle
skinparam linetype ortho
skinparam shadowing false
skinparam classAttributeIconSize 0
hide empty members

package "External World" {
  [Import Files\nTRA / GRA / LandXML / IFC / GND]
  [Public Geo Context\nmapLibre / GIS]
  [Reference Models\nIFC / Terrain / Docs]
  [Standards / Semantics\nlandXML / Technet / IFC]
}

package "Master Runtime (SharedWorker)" {
  [Messaging / Commands / Events]
  [ProjectState]

  package "Canonical Object World" {
    [SPOT Store]
    [SPOT Objects]
    [SPOT Relations]
    [Topology]
    [Engineering CRS]
  }

  package "Candidate / Context Layer" {
    [Working Set]
    [Reference Store]
  }
}

package "@kernel\n(calculation module)" {
  package "Alignment Domain" {
    [SparseAlignment]
    [Transition Families]
    [Validators]
    [Alignment Calculation]
    [Sampling]
    [Solver Prep]
  }
}

package "Window Clients" {
  package "Window A" {
    [WindowRuntime A]
    [WindowSession A]
    [Focus A]
    [ImportController A]
    [ViewController A]
    [SPOT View A]
    [GeoView A]
    [Transition Editor A]
  }

  package "Window B" {
    [WindowRuntime B]
    [WindowSession B]
    [Focus B]
    [ViewController B]
    [SPOT View B]
    [GeoView B]
  }
}

[Import Files\nTRA / GRA / LandXML / IFC / GND] --> [ImportController A]
[ImportController A] --> [Working Set]
[ImportController A] --> [SPOT Store]

[SPOT Store] --> [SPOT Objects]
[SPOT Store] --> [SPOT Relations]
[SPOT Store] --> [Topology]
[SPOT Store] --> [Engineering CRS]

[ViewController A] --> [Focus A]
[ViewController B] --> [Focus B]

[ViewController A] --> [SPOT Store]
[ViewController B] --> [SPOT Store]

[ViewController A] --> [Alignment Calculation]
[ViewController B] --> [Alignment Calculation]

[Alignment Calculation] --> [SparseAlignment]
[Alignment Calculation] --> [Transition Families]
[Alignment Calculation] --> [Sampling]
[Alignment Calculation] --> [Solver Prep]
[Alignment Calculation] --> [Validators]

[Sampling] --> [GeoView A]
[Sampling] --> [GeoView B]

[SPOT Store] --> [SPOT View A]
[SPOT Store] --> [SPOT View B]

[Transition Editor A] --> [Alignment Calculation]

[Public Geo Context\nmapLibre / GIS] --> [GeoView A]
[Public Geo Context\nmapLibre / GIS] --> [GeoView B]

note right of [SPOT Store]
Canonical parameters / metadata only.
No derived geometry.
No window-local active selection.
end note

note bottom of [Focus A]
Window-local focus only.
end note

note bottom of [Focus B]
Window-local focus only.
end note

note bottom of [Alignment Calculation]
@kernel defines where calculation belongs.
Execution model is still open
(same thread vs worker).
end note

@enduml
