@startuml
title ufAIM Zielbild – AI-coupled Architecture (v01)

skinparam linetype ortho
skinparam backgroundColor white
skinparam shadowing false
skinparam packageStyle rectangle
skinparam componentStyle rectangle
skinparam defaultTextAlignment left
skinparam wrapWidth 260
skinparam maxMessageSize 120

skinparam package {
  BorderColor #444444
  FontColor #222222
}
skinparam component {
  BorderColor #444444
  FontColor #222222
}
skinparam note {
  BorderColor #666666
  BackgroundColor #F8F8F8
}

legend right
  = Leitidee =
  KI formuliert Möglichkeiten
  ufAIM entscheidet Fachlichkeit
  Nutzer behält die Hoheit

  = Grundregel =
  Alles fachlich Bindende
  muss ohne KI vollständig
  funktionieren.
endlegend


actor User

package "Assistant Layer\n(interpreting / suggesting / explaining)" as AssistantLayer {

  package "app/assistant/intent" as AIntent {
    component "IntentInterpreter" as IntentInterpreter
    component "ActionProposalBuilder" as ActionProposalBuilder
    component "UserGoalNormalizer" as UserGoalNormalizer
  }

  package "app/assistant/suggestions" as ASuggest {
    component "ImportSuggestionEngine" as ImportSuggestionEngine
    component "SpotSuggestionEngine" as SpotSuggestionEngine
    component "RuleFixSuggestionEngine" as RuleFixSuggestionEngine
    component "VariantSuggestionEngine" as VariantSuggestionEngine
  }

  package "app/assistant/explain" as AExplain {
    component "ExplainService" as ExplainService
    component "DecisionNarrator" as DecisionNarrator
    component "ValidationNarrator" as ValidationNarrator
    component "CoordinateNarrator" as CoordinateNarrator
  }

  package "app/assistant/reporting" as AReport {
    component "ImportReportBuilder" as ImportReportBuilder
    component "ReviewSummaryBuilder" as ReviewSummaryBuilder
    component "ChangeSummaryBuilder" as ChangeSummaryBuilder
  }

  package "app/assistant/agents" as AAgents {
    component "TestCaseAssistant" as TestCaseAssistant
    component "ParserFuzzingAssistant" as ParserFuzzingAssistant
    component "DocumentationAssistant" as DocumentationAssistant
  }
}

package "Workflow / Session Layer\n(orchestration / commands / app-state)" as WorkflowLayer {

  package "app/session" as AppSession {
    component "ProjectSessionManager" as ProjectSessionManager
    component "WindowSessionState" as WindowSessionState
    component "FocusState" as FocusState
    component "SelectionState" as SelectionState
    component "ToolState" as ToolState
  }

  package "app/commands" as AppCommands {
    component "CommandRouter" as CommandRouter
    component "ImportFilesCommand" as ImportFilesCommand
    component "AssignSpotRoleCommand" as AssignSpotRoleCommand
    component "BuildRouteProjectCommand" as BuildRouteProjectCommand
    component "CommitAlignmentChangeCommand" as CommitAlignmentChangeCommand
    component "RunValidationCommand" as RunValidationCommand
  }

  package "app/controllers" as AppControllers {
    component "ImportController" as ImportController
    component "ViewController" as ViewController
    component "ProjectIOManager" as ProjectIOManager
    component "FocusManager" as FocusManager
    component "WorkflowController" as WorkflowController
  }

  note bottom of AppCommands
    Wichtige KI-Schnittstelle:
    Proposal != Command != Commit
  end note
}

package "Truth / State Layer\n(canonical objects / provenance / history)" as TruthLayer {

  package "src/model/project" as MProject {
    component "ProjectModel" as ProjectModel
    component "RouteProject" as RouteProject
  }

  package "src/model/spot" as MSpot {
    component "SPOT" as SPOT
    component "SpotObject" as SpotObject
    component "SpotAssignmentState" as SpotAssignmentState
  }

  package "src/model/artifacts" as MArtifacts {
    component "ImportArtifact" as ImportArtifact
    component "PreviewArtifact" as PreviewArtifact
    component "SparseCandidate" as SparseCandidate
  }

  package "src/model/provenance" as MProv {
    component "ProvenanceStore" as ProvenanceStore
    component "AssumptionRecord" as AssumptionRecord
    component "SourceTrace" as SourceTrace
  }

  package "src/model/history" as MHist {
    component "HistoryStore" as HistoryStore
    component "ChangeSet" as ChangeSet
    component "UndoRedoManager" as UndoRedoManager
  }
}

package "Domain Core\n(deterministic / mathematical / rule-bound)" as DomainCore {

  package "src/import" as DImport {
    package "sniffers" {
      component "sniffImportFile" as sniffImportFile
    }
    package "parsers" {
      component "parseTRA_GRA" as parseTRA_GRA
      component "parseLandXML" as parseLandXML
      component "parseGND_XLSX" as parseGND_XLSX
      component "parseIFC" as parseIFC
    }
    package "normalization" {
      component "normalizeToLandFAT" as normalizeToLandFAT
    }
    package "validation" {
      component "validateLandFAT" as validateLandFAT
    }
    package "staging" {
      component "buildImportResultFromParsed" as buildImportResultFromParsed
      component "buildSparseFromLandFAT" as buildSparseFromLandFAT
      component "classifyAlignmentForSpot" as classifyAlignmentForSpot
    }
  }

  package "src/domain/alignment" as DAlignment {
    component "Alignment2D" as Alignment2D
    component "AlignmentFactory" as AlignmentFactory
    component "FixedElement" as FixedElement
    component "TransitionElement" as TransitionElement
    component "ImmediateElement" as ImmediateElement
    component "KinkElement" as KinkElement
  }

  package "src/domain/transition" as DTransition {
    component "RegistryCompiler" as RegistryCompiler
    component "KappaFcnBuilder" as KappaFcnBuilder
    component "TransitionRegistry" as TransitionRegistry
    component "PresetSpec" as PresetSpec
  }

  package "src/domain/coordinates" as DCoords {
    component "CoordinateAgent" as CoordinateAgent
    component "CRSResolver" as CRSResolver
    component "TransformService" as TransformService
  }

  package "src/domain/rules" as DRules {
    component "RuleEngine" as RuleEngine
    component "AlignmentValidator" as AlignmentValidator
    component "TopologyValidator" as TopologyValidator
    component "CantProfileChecks" as CantProfileChecks
  }

  package "src/domain/optimization" as DOpt {
    component "OptimizationEngine" as OptimizationEngine
    component "ConstraintModel" as ConstraintModel
    component "VariantEvaluator" as VariantEvaluator
  }

  package "src/domain/builders" as DBuilders {
    component "RouteProjectBuilder" as RouteProjectBuilder
    component "CantLayoutBuilder" as CantLayoutBuilder
    component "ProfileBuilder" as ProfileBuilder
  }
}

package "View Layer\n(interaction / visualization / editing)" as ViewLayer {

  package "app/view" as AppView {
    component "WorkspaceHost / GeoView" as GeoView
    component "GrabbeltischView / SpotView" as SpotView
    component "TransitionEditorView" as TransitionEditorView
    component "MetaDataPreview" as MetaDataPreview
    component "SectionView / BandsView" as SectionBandsView
    component "Docs / Debug Panels" as DocsDebugPanels
  }

  package "src/engines" as Engines {
    component "GeoRenderEngine" as GeoRenderEngine
    component "MapLibreThreeEngine" as MapLibreThreeEngine
    component "MathRenderEngine" as MathRenderEngine
    component "JSXGraphEngine" as JSXGraphEngine
  }
}

package "Shared Services / Contracts" as SharedLayer {
  package "src/shared/messaging" {
    component "MessagingClient" as MessagingClient
    component "SharedWorkerClient" as SharedWorkerClient
    component "WorkerRouter" as WorkerRouter
  }

  package "src/shared/contracts" {
    component "CommandContract_v1" as CommandContract_v1
    component "ProposalContract_v1" as ProposalContract_v1
    component "ResultContract_v1" as ResultContract_v1
  }
}


' -----------------------------
' User / Assistant flow
' -----------------------------
User --> IntentInterpreter
User --> GeoView
User --> SpotView
User --> TransitionEditorView

IntentInterpreter --> UserGoalNormalizer
UserGoalNormalizer --> ActionProposalBuilder

ActionProposalBuilder --> ImportSuggestionEngine
ActionProposalBuilder --> SpotSuggestionEngine
ActionProposalBuilder --> RuleFixSuggestionEngine
ActionProposalBuilder --> VariantSuggestionEngine

' Proposal -> Command boundary
ActionProposalBuilder --> ProposalContract_v1
ProposalContract_v1 --> CommandRouter

' -----------------------------
' Workflow orchestration
' -----------------------------
ProjectSessionManager --> WindowSessionState
ProjectSessionManager --> FocusState
ProjectSessionManager --> SelectionState
ProjectSessionManager --> ToolState

WorkflowController --> ProjectSessionManager
WorkflowController --> CommandRouter
ImportController --> CommandRouter
ViewController --> ProjectSessionManager
FocusManager --> FocusState
ProjectIOManager --> ProjectModel

CommandRouter --> ImportFilesCommand
CommandRouter --> AssignSpotRoleCommand
CommandRouter --> BuildRouteProjectCommand
CommandRouter --> CommitAlignmentChangeCommand
CommandRouter --> RunValidationCommand

' -----------------------------
' Commands to domain/truth
' -----------------------------
ImportFilesCommand --> sniffImportFile
sniffImportFile --> parseTRA_GRA
sniffImportFile --> parseLandXML
sniffImportFile --> parseGND_XLSX
sniffImportFile --> parseIFC

parseTRA_GRA --> normalizeToLandFAT
parseLandXML --> normalizeToLandFAT
parseGND_XLSX --> normalizeToLandFAT
parseIFC --> normalizeToLandFAT

normalizeToLandFAT --> validateLandFAT
validateLandFAT --> buildImportResultFromParsed
buildImportResultFromParsed --> buildSparseFromLandFAT
buildImportResultFromParsed --> classifyAlignmentForSpot

buildImportResultFromParsed --> ImportArtifact
buildSparseFromLandFAT --> SparseCandidate
classifyAlignmentForSpot --> SPOT

AssignSpotRoleCommand --> SPOT
AssignSpotRoleCommand --> SpotAssignmentState

BuildRouteProjectCommand --> RouteProjectBuilder
RouteProjectBuilder --> ProjectModel
RouteProjectBuilder --> RouteProject

CommitAlignmentChangeCommand --> AlignmentFactory
AlignmentFactory --> Alignment2D
AlignmentFactory --> RegistryCompiler
RegistryCompiler --> KappaFcnBuilder
RegistryCompiler --> TransitionRegistry
TransitionRegistry --> PresetSpec

RunValidationCommand --> RuleEngine
RuleEngine --> AlignmentValidator
RuleEngine --> TopologyValidator
RuleEngine --> CantProfileChecks

BuildRouteProjectCommand --> CoordinateAgent
CoordinateAgent --> CRSResolver
CoordinateAgent --> TransformService

BuildRouteProjectCommand --> ProfileBuilder
BuildRouteProjectCommand --> CantLayoutBuilder

OptimizationEngine --> ConstraintModel
OptimizationEngine --> VariantEvaluator
OptimizationEngine --> ProjectModel
OptimizationEngine --> Alignment2D

' -----------------------------
' Truth / provenance / history
' -----------------------------
CommandRouter --> HistoryStore
HistoryStore --> ChangeSet
HistoryStore --> UndoRedoManager

ImportFilesCommand --> ProvenanceStore
AssignSpotRoleCommand --> ProvenanceStore
BuildRouteProjectCommand --> ProvenanceStore
CommitAlignmentChangeCommand --> ProvenanceStore

ProvenanceStore --> AssumptionRecord
ProvenanceStore --> SourceTrace

SPOT --> SpotObject
ProjectModel --> RouteProject
ImportArtifact --> PreviewArtifact

' -----------------------------
' View connections
' -----------------------------
ViewController --> GeoView
ViewController --> SpotView
ViewController --> TransitionEditorView
ViewController --> MetaDataPreview
ViewController --> SectionBandsView
ViewController --> DocsDebugPanels

GeoView --> GeoRenderEngine
GeoRenderEngine --> MapLibreThreeEngine

TransitionEditorView --> MathRenderEngine
MathRenderEngine --> JSXGraphEngine

SpotView --> SPOT
MetaDataPreview --> ImportArtifact
MetaDataPreview --> ProjectModel
SectionBandsView --> Alignment2D

' -----------------------------
' Explain/report after results
' -----------------------------
ResultContract_v1 --> ExplainService
ExplainService --> DecisionNarrator
ExplainService --> ValidationNarrator
ExplainService --> CoordinateNarrator

ImportReportBuilder --> ProvenanceStore
ImportReportBuilder --> ImportArtifact
ReviewSummaryBuilder --> HistoryStore
ChangeSummaryBuilder --> ChangeSet

ValidationNarrator --> RuleEngine
CoordinateNarrator --> CoordinateAgent
DecisionNarrator --> ProjectSessionManager

ExplainService --> User
ImportReportBuilder --> User
ReviewSummaryBuilder --> User
ChangeSummaryBuilder --> User

' -----------------------------
' Shared messaging / runtime coupling
' -----------------------------
CommandRouter --> CommandContract_v1
CommandRouter --> ResultContract_v1

MessagingClient --> SharedWorkerClient
SharedWorkerClient --> WorkerRouter
WorkerRouter --> TransitionRegistry

ViewController --> MessagingClient
ImportController --> MessagingClient
WorkflowController --> MessagingClient

note bottom of DomainCore
  Fachlich bindende Berechnung lebt hier:
  - deterministisch
  - testbar
  - reproduzierbar
  - KI-unabhängig
end note

note bottom of AssistantLayer
  KI-Aufgaben:
  - verstehen
  - vorschlagen
  - erklären
  - dokumentieren

  Nicht:
  - fachliche Wahrheit setzen
  - direkt ins Modell committen
end note

note bottom of TruthLayer
  Wahrheitsschicht:
  - canonical objects
  - provenance
  - history
  - reviewable state
end note

@enduml
