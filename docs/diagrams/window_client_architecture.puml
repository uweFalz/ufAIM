@startuml

title ufAIM Window Client Architecture

skinparam linetype ortho
skinparam packageStyle rectangle
skinparam shadowing false

package "Browser Window" {
  [WindowRuntime]
  [WindowSessionState]
  [FocusManager]
  [uiWiring]
  [ViewController]
}

package "Tool Controllers" {
  [ImportController]
  [TransitionEditorBridge]
}

package "Views" {
  [GeoView]
  [SPOT View]
  [TransitionEditorView]
}

package "Shared Canonical World" {
  [SpotStore]
  [WorkingSet]
}

package "@kernel" {
  [Alignment Calculation]
}

[WindowRuntime] --> [WindowSessionState]
[FocusManager] --> [WindowSessionState]

[uiWiring] --> [FocusManager]
[uiWiring] --> [SPOT View]

[ImportController] --> [WorkingSet]
[ImportController] --> [SpotStore]

[ViewController] --> [WindowSessionState]
[ViewController] --> [SpotStore]
[ViewController] --> [Alignment Calculation]
[ViewController] --> [GeoView]

[SPOT View] --> [SpotStore]

[TransitionEditorBridge] --> [Alignment Calculation]
[TransitionEditorBridge] --> [TransitionEditorView]

note right of [ViewController]
Reads:
- canonical objects
- window-local focus

Then requests derived geometry
from @kernel and renders this window.
end note

note bottom of [SPOT View]
Renders SPOT objects only.
No geometry generation.
No local shadow model.
end note

@enduml
