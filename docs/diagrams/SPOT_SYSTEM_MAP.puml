@startuml

title ufAIM – SPOT / Window / Kernel System Map

skinparam linetype ortho
skinparam packageStyle rectangle
skinparam shadowing false

package "External World" {
  [Import Files]
  [Public Geo Context\n(mapLibre / GIS)]
  [Reference Models\n(IFC / Terrain / Docs)]
}

package "Master Runtime\n(SharedWorker)" {
  [SpotStore]
  [WorkingSet]
  [ReferenceStore]
  [ProjectState]
}

package "Canonical SPOT Model" {
  [Spot Objects]
  [Spot Relations]
  [Topology]
  [Engineering CRS]
}

package "@kernel\n(calculation module)" {
  [Alignment Calculation]
  [Sampling / Projection Prep]
  [Solver Prep]
}

package "Window Client A" {
  [WindowRuntime A]
  [WindowSessionState A]
  [Focus A]
  [ImportController A]
  [ViewController A]
  [GeoView A]
}

package "Window Client B" {
  [WindowRuntime B]
  [WindowSessionState B]
  [Focus B]
  [ViewController B]
  [GeoView B]
}

[Import Files] --> [ImportController A]
[ImportController A] --> [WorkingSet]
[ImportController A] --> [SpotStore]

[SpotStore] --> [Spot Objects]
[SpotStore] --> [Spot Relations]
[SpotStore] --> [Topology]
[SpotStore] --> [Engineering CRS]

[ViewController A] --> [SpotStore]
[ViewController B] --> [SpotStore]

[ViewController A] --> [Focus A]
[ViewController B] --> [Focus B]

[ViewController A] --> [Alignment Calculation]
[ViewController B] --> [Alignment Calculation]

[Alignment Calculation] --> [Sampling / Projection Prep]
[Alignment Calculation] --> [Solver Prep]

[Sampling / Projection Prep] --> [GeoView A]
[Sampling / Projection Prep] --> [GeoView B]

[Public Geo Context\n(mapLibre / GIS)] --> [GeoView A]
[Public Geo Context\n(mapLibre / GIS)] --> [GeoView B]

note right of [SpotStore]
Stores canonical object parameters / metadata only.
No view geometry.
No solver geometry.
end note

note bottom of [Focus A]
Window-local only.
Not shared with other windows.
end note

note bottom of [Focus B]
Window-local only.
Not shared with other windows.
end note

note bottom of [Alignment Calculation]
@kernel is a module boundary.
Runtime execution model
(in-window vs worker) is open.
end note

@enduml
