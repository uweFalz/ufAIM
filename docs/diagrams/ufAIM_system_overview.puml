@startuml

title ufAIM System Architecture Overview

skinparam packageStyle rectangle

package "External Data" {

    [TRA / GRA]
    [LandXML]
    [IFC]
    [Terrain / GIS]
}

package "Import Pipeline" {

    [Parser]

    [landFAT]
    [Normalizer]

    [Working Set]
}

package "Canonical Model" {

    [SPOT Store]

    [Alignments]
    [Relations]
    [RouteProjects]
    [CRS]
}

package "Engineering Core" {

    [SparseAlignment]

    [Transition Families]

    [Solver]
}

package "Views / Tools" {

    [GeoView]
    [Transition Editor]
    [Grabbeltisch]
    [Validators]
}

package "Runtime Architecture" {

    [SharedWorker]
    [Window Clients]

}

[TRA / GRA] --> [Parser]
[LandXML] --> [Parser]
[IFC] --> [Parser]

[Parser] --> [landFAT]
[landFAT] --> [Normalizer]
[Normalizer] --> [Working Set]

[Working Set] --> [SPOT Store]

[SPOT Store] --> [Alignments]
[SPOT Store] --> [Relations]
[SPOT Store] --> [RouteProjects]

[Alignments] --> [SparseAlignment]

[SparseAlignment] --> [Transition Families]
[SparseAlignment] --> [Solver]

[SPOT Store] --> [SharedWorker]

[SharedWorker] --> [Window Clients]

[Window Clients] --> [GeoView]
[Window Clients] --> [Transition Editor]
[Window Clients] --> [Grabbeltisch]

@enduml
